<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="Color" type="Color">
      <label>Color de fondo</label>
      <default>#0B0B0D</default>
    </entry>
    <entry name="ShowDiagnostics" type="Bool">
      <label>Mostrar el HUD de diagnostico</label>
      <default>true</default>
    </entry>
    <!-- 0 nunca, 1 con una ventana maximizada o a pantalla completa,
         2 con cualquier ventana visible. -->
    <entry name="PauseMode" type="Int">
      <label>Cuando dejar de dibujar el fondo</label>
      <default>1</default>
    </entry>
    <!-- Como se lleva el lienzo del autor a la pantalla, que casi nunca tienen
         la misma proporcion: 0 cubrir recortando, 1 entera con barras,
         2 estirar. Ver GlExecutor::Encaje, que define los valores. -->
    <entry name="FitMode" type="Int">
      <label>Como encajar la escena en la pantalla</label>
      <default>0</default>
    </entry>
    <entry name="Zoom" type="Double">
      <label>Acercamiento sobre la escena</label>
      <default>1.0</default>
    </entry>
    <!-- Que trozo se ve cuando sobra escena: -1 todo a un lado, 0 centro,
         +1 al otro. En Y, positivo es hacia arriba. -->
    <entry name="OffsetX" type="Double">
      <label>Desplazamiento horizontal del recorte</label>
      <default>0.0</default>
    </entry>
    <entry name="OffsetY" type="Double">
      <label>Desplazamiento vertical del recorte</label>
      <default>0.0</default>
    </entry>
  </group>

</kcfg>
